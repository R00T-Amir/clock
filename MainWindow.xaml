<Window x:Class="ChronoDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R00T CLOCK" Height="200" Width="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        FlowDirection="{Binding FlowDirection, Source={StaticResource Loc}}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding [ChangeTheme], Source={StaticResource Loc}}">
                <MenuItem Header="{Binding [DarkMode], Source={StaticResource Loc}}" Click="Theme_Dark_Click"/>
                <MenuItem Header="{Binding [LightMode], Source={StaticResource Loc}}" Click="Theme_Light_Click"/>
                <MenuItem Header="{Binding [Cyberpunk], Source={StaticResource Loc}}" Click="Theme_Cyber_Click"/>
            </MenuItem>
            <MenuItem Header="{Binding [Opacity], Source={StaticResource Loc}}">
                <MenuItem Header="100%" Click="Opacity_100_Click"/>
                <MenuItem Header="80%" Click="Opacity_80_Click"/>
                <MenuItem Header="50%" Click="Opacity_50_Click"/>
            </MenuItem>
            <MenuItem Header="Clock Mode">
                <MenuItem Header="Digital" Click="Mode_Digital_Click"/>
                <MenuItem Header="LED (Red)" Click="Mode_LED_Click"/>
                <MenuItem Header="Analog" Click="Mode_Analog_Click"/>
            </MenuItem>
            <MenuItem Header="{Binding [Calendar], Source={StaticResource Loc}}">
                <MenuItem Header="{Binding [Gregorian], Source={StaticResource Loc}}" Click="Cal_Gregorian_Click"/>
                <MenuItem Header="{Binding [Jalali], Source={StaticResource Loc}}" Click="Cal_Jalali_Click"/>
                <MenuItem Header="{Binding [Both], Source={StaticResource Loc}}" Click="Cal_Both_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{Binding [CloseWidget], Source={StaticResource Loc}}" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="MainBorder" CornerRadius="15" Background="#CC1F1F1F" Margin="10" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <StackPanel x:Name="DigitalPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CityText" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,5" FontFamily="Segoe UI Variable Display" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TimeText" FontSize="28" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display"/>
                <TextBlock x:Name="DateText" FontSize="10" Foreground="#99FFFFFF" 
                           HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="Segoe UI Variable Display" 
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="JalaliDateText" FontSize="10" Foreground="#99FFFFFF" 
                           HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="Segoe UI Variable Display" 
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"/>
            </StackPanel>

            <Grid x:Name="LEDPanel" Visibility="Collapsed" Background="Black" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" Margin="10,5,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LEDTimeText" Text="00:00:00" FontSize="60" FontWeight="Bold" 
                               FontFamily="Consolas" Foreground="#FFFF0000">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="1" Color="Red"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
                <TextBlock x:Name="LEDCityText" Grid.Row="1" Text="Local" FontSize="10" 
                           FontFamily="Consolas" Foreground="#66FF0000" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
            </Grid>

            <Grid x:Name="AnalogPanel" Visibility="Collapsed" Width="150" Height="150">
                <Ellipse Fill="#11000000" Stroke="#99FFFFFF" StrokeThickness="2"/>
                <Line x:Name="HourHand" X1="0" Y1="0" X2="0" Y2="-40" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="HourRotation" Angle="0"/>
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="MinuteHand" X1="0" Y1="0" X2="0" Y2="-60" Stroke="#99FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="MinuteRotation" Angle="0"/>
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="SecondHand" X1="0" Y1="0" X2="0" Y2="-70" Stroke="Red" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="SecondRotation" Angle="0"/>
                    </Line.RenderTransform>
                </Line>
                <TextBlock x:Name="AnalogCityText" Text="" FontSize="10" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" FontFamily="Segoe UI Variable Display"/>
            </Grid>
        </Grid>
    </Border>
</Window>
